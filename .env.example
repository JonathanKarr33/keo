# Copy to .env and fill in real values. .env is gitignored.

# OpenAI (KG extraction / legacy)
OPENAI_API_KEY=your_openai_api_key_here

# OpenRouter (larger answerers: Gemma-4 31B, etc.)
# https://openrouter.ai/keys
OPENROUTER_API_KEY=your_openrouter_api_key_here

# Optional overrides for run_openrouter_generator.sh
# OPENROUTER_MODEL=google/gemma-4-31b-it
# RUN_ID=openrouter_gemma4_31b
